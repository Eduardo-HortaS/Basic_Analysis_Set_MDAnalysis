/*
 * MD Analysis Pipeline - Nextflow Configuration
 *
 * nf-core standards followed:
 *   - DSL2 enabled
 *   - Profiles for different execution environments
 *   - Resource labels for process scaling
 *   - publishDir for results
 *
 * Deviations from full nf-core template:
 *   - No MultiQC: not applicable to MD trajectory analysis
 *   - No nf-validation plugin: pipeline has few params, validated in scripts
 *   - No Tower/Seqera integration: specialized pipeline, not community-scale
 */

// Load base config
includeConfig 'conf/base.config'

// Default parameters
params {
    // These can be overridden on the command line or in profile configs
    outdir = 'results_nf'
    enable_pipeline_info = true
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
    }

    test {
        includeConfig 'conf/test.config'
    }

    // Opt-in profile for 16-core / 16 GB machines.
    // Use with: -profile test,local16
    local16 {
        includeConfig 'conf/local16.config'
    }



    conda {
        conda.enabled = true
        // Prefer using uv-managed environments:
        //   uv sync --all-extras
        //   nextflow run main.nf -profile conda
        process.conda = "${projectDir}/pyproject.toml"
    }

    docker {
        docker.enabled = true
        // Users should build/specify their own container with MDAnalysis installed
        // process.container = 'mdanalysis/mdanalysis:latest'
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}

// Manifest
manifest {
    name            = 'Basic_Analysis_Set_MDAnalysis'
    author          = 'Eduardo Horta'
    description     = 'Nextflow pipeline for MD trajectory analysis using MDAnalysis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '1.0.0'
}

// Capture execution reports
timeline {
    enabled = params.enable_pipeline_info
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = params.enable_pipeline_info
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = params.enable_pipeline_info
    file    = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
}

dag {
    enabled = params.enable_pipeline_info
    file    = "${params.outdir}/pipeline_info/dag.svg"
    overwrite = true
}
