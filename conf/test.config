/*
 * Test profile configuration
 *
 * Uses the reduced test data in .test_data/ directory.
 * Run with: nextflow run main.nf -profile test
 */

params {
    // Test data configuration
    systems         = '["Ung_G-C_4"]'
    variations      = '{"Ung_G-C_4": ["wild"]}'
    num_replicates  = 1
    traj_format     = 'dcd'
    top_format      = 'top'
    start_frame     = 0
    input_dir       = "${projectDir}/.test_data"
    outdir          = "${projectDir}/results_test"

    // Enable core analyses for testing
    run_rmsd    = true
    run_rmsf    = true
    run_2d_rmsd = false   // Disabled by default in test — slow on large systems
    run_rog     = true
    run_hbonds  = false   // Requires specific selections

    // Per-analysis plot toggles
    plot_rmsd    = true
    plot_rmsf    = true
    plot_2d_rmsd = false
    plot_rog     = true
    plot_hbonds  = false

    // Selections for the Ung_G-C_4 test system
    target_selection = 'protein and backbone'
    ref_selection    = 'protein and backbone'
    rog_selection    = 'protein and backbone'

    // DCD time correction for testing
    time_interval_between_frames = 2.0   // 2 ps between frames (example)
    time_unit   = 'ns'

    // Plot settings
    dpi = 150  // Lower DPI for faster test runs
}

// Reduced resources for test runs
process {
    cpus   = 1
    memory = '2.GB'
    time   = '30.min'

    withLabel: 'process_high' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
}
