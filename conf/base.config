/*
 * Base resource configuration for MD Analysis Pipeline
 *
 * Defines resource labels used by processes following nf-core conventions.
 */

process {
    // Prepend repository-local virtual environment if it exists.
    // This keeps process execution machine-agnostic across users/hosts.
    beforeScript = "if [ -d \"${projectDir}/.venv/bin\" ]; then export PATH=\"${projectDir}/.venv/bin\":\$PATH; fi"

    // Default resources
    cpus   = 1
    memory = '4.GB'
    time   = '2.h'

    // Error handling
    errorStrategy = 'retry'
    maxRetries    = 1

    withLabel: 'process_low' {
        cpus   = 1
        memory = '2.GB'
        time   = '30.min'
    }

    withLabel: 'process_medium' {
        cpus   = 2
        memory = '8.GB'
        time   = '4.h'
    }

    withLabel: 'process_high' {
        cpus   = 4
        memory = '16.GB'
        time   = '12.h'
    }
}
