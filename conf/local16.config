/*
 * Local profile for hosts with ~16 CPU cores and ~16 GB RAM.
 *
 * Goal:
 *   - avoid hard failure from process_high requesting 16 GB when
 *     Nextflow detects slightly less available memory (e.g. 15.6 GB)
 *   - enable stronger MDAnalysis-level parallel defaults for RMSD/H-bonds
 *
 * Usage:
 *   nextflow run main.nf -profile test,local16
 *
 * Override at runtime if needed:
 *   --parallel_backend serial
 *   --n_workers 4
 */

params {
    parallel_backend = 'multiprocessing'
    n_workers = 12
}

process {
    withLabel: 'process_high' {
        memory = '10.GB'
        time = '4.h'
    }
}
